# Development defaults, never real secrets.
# Copy to .env and adjust only if a default collides with something already
# running locally. docker-compose.yml falls back to these same values.

POSTGRES_DB=karar
POSTGRES_USER=karar
POSTGRES_PASSWORD=karar_dev_password
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=karar
MINIO_ROOT_PASSWORD=karar_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# apps/api listen port
PORT=3000

# OpenTelemetry collector host ports (loopback-bound in docker-compose.yml)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# --- Typed application configuration (packages/platform/src/config) ---------
# Configuration is validated at boot; a missing or malformed value fails
# startup with field names only (docs/architecture/environments.md section 7).

# Environment identity: local | dev | staging | production. Required — the
# process refuses to boot without it, and unknown values are rejected.
KARAR_ENV=local

# Reported as service.version in logs/traces/metrics (deploys set the build id).
KARAR_SERVICE_VERSION=dev

# OTLP/HTTP endpoint telemetry is exported to (the compose otel-collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Set to false to disable exporters (context propagation stays on).
KARAR_TELEMETRY_ENABLED=true

# fatal | error | warn | info | debug | trace ('silent' is deliberately not
# accepted — production keeps its forensic timeline, backend.md section 11).
KARAR_LOG_LEVEL=info

# Database host for the api/worker processes (compose publishes on loopback).
POSTGRES_HOST=127.0.0.1

# Role credentials for the local database (packages/platform/src/db fromEnv;
# roles are created by `pnpm --filter @karar/platform db:create`).
# Development placeholders only — never real secrets.
KARAR_DB_MIGRATOR_PASSWORD=karar_migrator_dev_password
KARAR_DB_APP_PASSWORD=karar_app_dev_password
