{
  "name": "@karar/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP entrypoint. Boots the root module and starts the HTTP adapter.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsc -b && node --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --exclude \"**/node_modules/**\" --exclude \"**/dist/**\""
  },
  "dependencies": {
    "@karar/api-contracts": "workspace:*",
    "@karar/audit": "workspace:*",
    "@karar/authorization": "workspace:*",
    "@karar/bootstrap": "workspace:*",
    "@karar/capability": "workspace:*",
    "@karar/capability-registry": "workspace:*",
    "@karar/consent": "workspace:*",
    "@karar/control-plane": "workspace:*",
    "@karar/financial-accounts": "workspace:*",
    "@karar/financial-connections": "workspace:*",
    "@karar/identity": "workspace:*",
    "@karar/jurisdiction": "workspace:*",
    "@karar/jurisdiction-policy": "workspace:*",
    "@karar/operating-entity": "workspace:*",
    "@karar/payment-instruments": "workspace:*",
    "@karar/platform": "workspace:*",
    "@karar/shared-kernel": "workspace:*",
    "@karar/statement-imports": "workspace:*",
