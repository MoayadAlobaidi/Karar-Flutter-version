<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE MANIFEST.

  Attributes on <application> that are security controls rather than defaults:

    android:networkSecurityConfig
        Points at res/xml/network_security_config.xml, which forbids cleartext
        and trusts only the system certificate store. The debug source set
        supplies its own copy of that resource with a loopback-only cleartext
        exception; the release variant does not contain the exception at all.

    android:usesCleartextTraffic="false"
        Ignored on API 24+ when a network security config is present, and
        minSdk is 24 — so this line changes no behaviour. It is here because it
        is the attribute reviewers, scanners and store review processes look
        for, and because leaving it unset would make its absence ambiguous
        rather than deliberate.

    android:allowBackup / android:fullBackupContent
        Android auto-backup would copy application data into the user's cloud
        backup. flutter_secure_storage keeps session tokens in Keystore-backed
        encrypted preferences; backing that up moves credential material out of
        the device's protected storage and makes it restorable onto a different
        device. Backup is therefore off. Nothing is lost: this client holds no
        local state worth preserving — everything authoritative is server-side.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      INTERNET is the ONLY permission this application requests.

      The Flutter template declares it in the debug and profile source sets
      only, which means a release build assembled from that template has no
      network access whatsoever. This client exists to talk to an API, so the
      permission belongs here, in the manifest that actually ships.

      Nothing else is requested: no location, contacts, storage, camera, phone
      state, or advertising identifier. A permission that is never declared
      cannot be abused, and each of those would create a privacy disclosure
      obligation the product has no need to take on.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="karar_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
