<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Karar Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>karar_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  APP TRANSPORT SECURITY.

	  NSAllowsArbitraryLoads is false and is stated rather than omitted. The
	  platform default is already false, so this line changes no behaviour; it
	  exists so that a future "just for now" change to true is a visible edit to
	  an explicit decision instead of the addition of a missing key. The
	  companion blanket keys — NSAllowsArbitraryLoadsInWebContent,
	  NSAllowsArbitraryLoadsForMedia and NSAllowsLocalNetworking — are absent,
	  and a regression test asserts they stay absent.

	  There is exactly ONE exception, for `localhost`, with subdomains excluded.
	  It exists because ATS applies to loopback connections and the LOCAL
	  profile runs the API on the developer's own machine at
	  http://localhost:3000 — the same address the Dart configuration loader
	  uses as its LOCAL default. IP literals are not listed: ATS exception
	  domains are matched as domain names, so 127.0.0.1 would not take effect.
	  iOS local development therefore uses `localhost`, not the IP.

	  SCOPE — AND ITS LIMIT, STATED PLAINLY. Unlike Android, where the debug
	  source set physically replaces the network security config so the release
	  variant does not contain the exception, iOS builds one Info.plist for
	  every configuration. This exception is therefore PRESENT in a release
	  binary. What makes it unreachable is enforced one layer up, in code that
	  is tested: the configuration loader rejects a non-LOCAL build whose API
	  base URL is a loopback host (API_BASE_URL_LOCAL_IN_NON_LOCAL_BUILD) and
	  rejects any non-LOCAL base URL that is not https (API_BASE_URL_INSECURE),
	  and a release build with no base URL fails outright rather than falling
	  back. A release binary consequently has no configuration that could ever
	  direct a request at localhost. The residual risk is a future code path
	  that hardcodes a loopback URL instead of reading the loader; the mobile
	  security regression suite asserts that no such literal exists.

	  NO pinning. Certificate pinning is not a Phase 4 requirement; that
	  decision is on record and changing it needs an ADR, not an edit here.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<!--
	  FACE ID PURPOSE STRING.

	  Required by the platform before the application lock may ask the device to
	  authenticate its owner. Without this key iOS terminates the process on the
	  first Face ID evaluation, so its absence is not a graceful degradation.

	  It is the ONLY usage-description key in this file. Nothing else is
	  requested: no camera, contacts, location, photo library, microphone or
	  tracking. Each of those would create a privacy disclosure obligation this
	  product has no need to take on.

	  WHAT THE STRING HAS TO BE HONEST ABOUT. The lock is a LOCAL PRIVACY
	  CONTROL. The device performs the comparison and answers yes or no; Karar
	  receives no template, image or derived representation, stores none and
	  transmits none. Unlocking proves presence to the device, grants no
	  session, and never replaces signing in. The sentence below says exactly
	  that in the user's own terms rather than the vendor's.

	  This is the development-language string. Localized copies belong in a
	  per-language InfoPlist.strings, which is separate work from wiring the
	  authenticator and is not done here.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>Karar uses Face ID to unlock the app on this device. This is a privacy lock only: it never replaces signing in, and Karar never receives your face data.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
