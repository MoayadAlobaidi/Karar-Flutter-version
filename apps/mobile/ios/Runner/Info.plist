<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Karar Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>karar_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  APP TRANSPORT SECURITY IS ABSENT FROM THIS FILE, AND THAT IS THE CONTROL.

	  iOS builds ONE Info.plist for every configuration, so anything written
	  here ships in every artifact. The narrow localhost exception the LOCAL
	  profile needs therefore does not live here. It lives in
	  Runner/ATSLocalDevelopment.plist and is merged into the PACKAGED plist by
	  the `Verify Packaged Bundle` build phase, and only when that phase can
	  prove the build is a Debug build compiled for LOCAL.

	  THE SAFE STATE IS THE DEFAULT STATE. There is no switch here with an off
	  position that has to be set correctly. A DEV, STAGING or PRODUCTION
	  artifact has no NSAppTransportSecurity key at all and gets the unmodified
	  platform transport policy: TLS validated normally, no exception domain,
	  no arbitrary-load key of any kind. Every way the mechanism can fail —
	  the build phase deleted, the fragment missing, the environment
	  undetermined, plutil erroring — produces an artifact WITHOUT the
	  exception, because producing one WITH it takes a positive action that has
	  to succeed.

	  The build phase also verifies, in every configuration, that no
	  arbitrary-load key reached the packaged plist from any other source, and
	  fails the build if one did. See ios/Scripts/verify_packaged_bundle.sh.

	  NO pinning. Certificate pinning is not a Phase 4 requirement; that
	  decision is on record and changing it needs an ADR, not an edit here.
	-->
	<!--
	  FACE ID PURPOSE STRING.

	  Required by the platform before the application lock may ask the device to
	  authenticate its owner. Without this key iOS terminates the process on the
	  first Face ID evaluation, so its absence is not a graceful degradation.

	  It is the ONLY usage-description key in this file. Nothing else is
	  requested: no camera, contacts, location, photo library, microphone or
	  tracking. Each of those would create a privacy disclosure obligation this
	  product has no need to take on.

	  WHAT THE STRING HAS TO BE HONEST ABOUT. The lock is a LOCAL PRIVACY
	  CONTROL. The device performs the comparison and answers yes or no; Karar
	  receives no template, image or derived representation, stores none and
	  transmits none. Unlocking proves presence to the device, grants no
	  session, and never replaces signing in. The sentence below says exactly
	  that in the terms of the user rather than of the vendor.

	  This is the development-language value, and it is the fallback iOS uses
	  when the device language matches no localization. The strings a user
	  actually sees come from Runner/en.lproj/InfoPlist.strings and
	  Runner/ar.lproj/InfoPlist.strings; the English there is identical to this
	  value, so the fallback and the localization cannot say different things.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks Karar on this device. Your device performs the check and Karar never receives or stores your face data. Unlocking the app does not replace signing in.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
