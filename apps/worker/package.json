{
  "name": "@karar/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background entrypoint. Second entrypoint, not a second application (ADR-0013).",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsc -b && node --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --exclude \"**/node_modules/**\" --exclude \"**/dist/**\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.0",
    "@types/node": "^26.2.0"
  }
}
