{
  "name": "@karar/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background entrypoint. Second entrypoint, not a second application (ADR-0013).",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsc -b && node --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --exclude \"**/node_modules/**\" --exclude \"**/dist/**\""
  },
  "dependencies": {
    "@karar/api-contracts": "workspace:*",
    "@karar/platform": "workspace:*",
    "@karar/shared-kernel": "workspace:*",
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.0",
    "@types/node": "^25.9.5"
  }
}
